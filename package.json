    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "glob": "^13.0.6",
    "html2pdf.js": "^0.14.0",
    "jsdom": "^30.0.1",
    "katex": "^0.18.7",
